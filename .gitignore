# ── Build Outputs ─────────────────────────────────────────────────────────────
dist/
dist-electron/

# ── Electron-Builder Release Artifacts ───────────────────────────────────────
release/
# Keep release/ excluded — binaries are published via GitHub Releases, not git

# ── Generated NSIS Branding Assets (auto-generated by scripts/generate_nsis_assets.py) ──
build/installerSidebar.bmp
build/installerHeader.bmp

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ── OS Files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Editor & IDE ──────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.user

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Python Bytecode (scripts/) ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Temporary Files ───────────────────────────────────────────────────────────
*.tmp
*.temp
release/_empty_clean/
release/__empty__/

# ── Electron-Builder Metadata (generated) ────────────────────────────────────
release/builder-debug.yml
release/builder-effective-config.yaml

# ── What TO Keep Tracked ─────────────────────────────────────────────────────
# build/icon.ico         ← keep (required for packaging)
# build/icon.png         ← keep (required for packaging)
# build/icon-256.png     ← keep (required for packaging)
# docs/                  ← keep (GitHub Pages site)
# bin/                   ← keep (yt-dlp + ffmpeg binaries shipped with app)
# extension/             ← keep (browser extension source)
# src/                   ← keep (React source)
# electron/              ← keep (main process source)
# scripts/               ← keep (build scripts)
# package-lock.json      ← keep (reproducible installs)
